			<key>max</key>
			<integer>100</integer>
			<key>showValue</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Liquid Glass 强度</string>
			<key>footerText</key>
			<string>只用于 Liquid Glass。继续控制 blur、saturation、白色透光与镜面高光等综合玻璃响应。与 Clear 模糊强度分开记忆。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>cellClass</key>
			<string>GFPercentSliderCell</string>
