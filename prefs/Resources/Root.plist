			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
			<key>validTitles</key>
			<array>
				<string>Clear</string>
				<string>Liquid Glass</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Clear 模糊强度</string>
			<key>footerText</key>
			<string>只用于 Clear。强度主要控制打开/关闭文件夹的局部模糊程度；白色透光和高光只做轻微补偿，不会随着滑杆明显变白。与 Liquid Glass 强度分开记忆。</string>
		</dict>
