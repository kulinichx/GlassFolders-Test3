<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>GlassFolders</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>GlassFolders 0.7.4 Beta 3.1</string>
			<key>footerText</key>
			<string>Beta 3.1：Clear 浅色 V2 保持不变。本版只收敛 Liquid Glass：浅色关闭态降低亮度、白色覆盖与 App Library pod 参与度，避免文件夹图标像发亮粉色卡片；打开态减少灰雾与局部模糊，提高真实壁纸色彩/亮度穿透，并把玻璃识别主要交给顶部/左上方向性高光、圆角结构与左下局部 specular glint。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>风格</string>
			<key>footerText</key>
			<string>Clear：颜色只来自真实壁纸/backdrop，不添加紫、蓝、粉等彩色 tint。Clear 本身从最低强度就保持干净透亮；强度提高时主要增加模糊、色彩分离与边缘/高光结构，而不是明显增加白色透光。Liquid Glass：浅色关闭态更克制、更少发白；打开态更透明、更少灰雾，并用方向性高光和局部折射感突出玻璃。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string></string>
			<key>key</key>
			<string>Style</string>
			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
			<key>validTitles</key>
			<array>
				<string>Clear</string>
				<string>Liquid Glass</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Clear 强度</string>
			<key>footerText</key>
			<string>只用于 Clear。0% 已经保持高透亮/低灰雾，只是不额外增加局部模糊与结构；往上主要增加 Gaussian 模糊、颜色/层次分离和边缘高光，100% 打开态仍约 40pt。透亮本身只做小幅变化，避免低档闷灰、高档又只是变白。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>cellClass</key>
			<string>GFPercentSliderCell</string>
			<key>label</key>
			<string></string>
			<key>key</key>
			<string>ClearStrength</string>
			<key>default</key>
			<integer>55</integer>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>100</integer>
			<key>showValue</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Liquid Glass 强度</string>
			<key>footerText</key>
			<string>只用于 Liquid Glass。滑杆继续控制 blur、真实壁纸色彩/亮度穿透与镜面高光。浅色打开态会减少均匀白雾，把更多视觉强度放在顶部/圆角/局部 specular 上；与 Clear 强度分开记忆。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>cellClass</key>
			<string>GFPercentSliderCell</string>
			<key>label</key>
			<string></string>
			<key>key</key>
			<string>LiquidGlassStrength</string>
			<key>default</key>
			<integer>55</integer>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>100</integer>
			<key>showValue</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Beta 3.1 的 Liquid Glass 关闭态在浅色模式下降低 native pod、白色 tint、brightness 与光学层整体能量，避免过亮；深色关闭态保留原基线。打开态浅色模式降低 blur、提高 backdrop saturation / luminance、减薄白色 tint，并弱化整圈 border、强化顶部/左上主高光与左下局部 glint。真实 App 资源库不会被 hook 或修改。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>应用并注销</string>
			<key>action</key>
			<string>respring</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>关于</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>作者</string>
			<key>get</key>
			<string>authorValue:</string>
		</dict>
	</array>
</dict>
</plist>
