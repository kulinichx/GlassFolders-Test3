<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>GlassFolders</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>GlassFolders 0.5</string>
			<key>footerText</key>
			<string>轻量优先：不运行后台进程、不持续刷新、不额外模糊整个桌面。设置修改后 Respring 一次生效。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>启用</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>风格</string>
			<key>footerText</key>
			<string>Clear 只处理桌面文件夹；Liquid Glass 同时让打开后的文件夹使用更通透的系统原生玻璃材质。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSegmentCell</string>
			<key>label</key>
			<string></string>
			<key>key</key>
			<string>Style</string>
			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
			<key>validTitles</key>
			<array>
				<string>Clear</string>
				<string>Liquid Glass</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
			</array>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>玻璃强度</string>
			<key>footerText</key>
			<string>0% 最轻；数值越高玻璃更明显。为避免 iOS 16 PreferenceLoader 的右侧数值裁切，本版不在滑块右侧显示小数值。建议 Liquid Glass 从 35–55% 开始。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>玻璃强度</string>
			<key>key</key>
			<string>GlassStrength</string>
			<key>default</key>
			<integer>0</integer>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
			<key>min</key>
			<integer>0</integer>
			<key>max</key>
			<integer>100</integer>
			<key>showValue</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>性能设计：Clear=0% 时不会创建模糊视图；Liquid Glass 打开文件夹时只调整系统已有背景材质的透明度，不创建额外全屏 blur，也没有持续动画线程。</string>
		</dict>
	</array>
</dict>
</plist>
