			<string>启用</string>
			<key>key</key>
			<string>Enabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.local.glassfolders</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>风格</string>
			<key>footerText</key>
			<string>Clear：颜色只来自壁纸/桌面 backdrop，本身不添加紫、蓝、粉等彩色 tint；使用比 Liquid Glass 更浅的局部 blur、更高的 backdrop 保留率与柔和白色高光。深色模式增加少量中性亮度/白色透光，浅色模式自动收弱。Liquid Glass：保持更厚的 blur / saturation 与更强白色镜面高光。</string>
		</dict>
